rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitive Helpers
    function isSignedIn() { return request.auth != null; }
    function isVerified() { return isSignedIn() && request.auth.token.email_verified == true; }
    function isAdmin() { 
      return isVerified() && (
        request.auth.token.email == 'muhammad.nawa@gmail.com' || 
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }
    function existing() { return resource.data; }
    function incoming() { return request.resource.data; }

    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }

    match /admins/{userId} {
      allow read: if isVerified();
      // Only admins can create/update admins
      allow write: if isAdmin();
    }

    // ----------------------------------------------------
    // Collection: staff
    // ----------------------------------------------------
    function isValidStaff(data) {
      return data.keys().hasAll(['name', 'role', 'department', 'email', 'phone', 'status', 'joinDate', 'leaveBalance']) &&
             data.name is string && data.name.size() <= 100 &&
             data.role is string && data.role.size() <= 100 &&
             data.department is string && data.department.size() <= 100 &&
             data.email is string && data.email.size() <= 100 &&
             data.phone is string && data.phone.size() <= 50 &&
             data.status is string && ((data.status == 'Aktif') || (data.status == 'Cuti') || (data.status == 'Nonaktif')) &&
             data.joinDate is string && data.joinDate.size() <= 30 &&
             data.leaveBalance is number;
    }

    match /staff/{staffId} {
      allow read: if isVerified();
      allow create: if isAdmin() && isValidId(staffId) && isValidStaff(incoming());
      allow update: if isVerified() && isValidId(staffId) && isValidStaff(incoming()) && (
        isAdmin() ||
        (incoming().diff(existing()).affectedKeys().hasOnly(['status', 'leaveBalance', 'specialLeaveBalance', 'allocationsCount']))
      );
      allow delete: if isAdmin() && isValidId(staffId);
    }

    // ----------------------------------------------------
    // Collection: inventory
    // ----------------------------------------------------
    function isValidInventory(data) {
      return data.name is string &&
             data.code is string &&
             data.category is string &&
             data.quantity is number &&
             data.status is string &&
             data.location is string &&
             data.purchaseDate is string;
    }

    match /inventory/{inventoryId} {
      allow read: if isVerified();
      allow create: if isVerified() && isValidId(inventoryId) && isValidInventory(incoming()) && (
        (!('assignedToId' in incoming().keys())) || 
        (incoming().assignedToId == null) || 
        exists(/databases/$(database)/documents/staff/$(incoming().assignedToId))
      );
      allow update: if isVerified() && isValidId(inventoryId) && isValidInventory(incoming()) && (
        (!('assignedToId' in incoming().diff(existing()).affectedKeys())) || 
        (incoming().assignedToId == null) || 
        exists(/databases/$(database)/documents/staff/$(incoming().assignedToId))
      );
      allow delete: if isAdmin() && isValidId(inventoryId);
    }

    // ----------------------------------------------------
    // Collection: leaves
    // ----------------------------------------------------
    function isValidLeave(data) {
      return data.keys().hasAll(['staffId', 'staffName', 'leaveType', 'startDate', 'endDate', 'durationDays', 'reason', 'status', 'requestDate']) &&
             data.staffId is string && data.staffId.size() <= 128 &&
             data.staffName is string && data.staffName.size() <= 100 &&
             data.leaveType is string && data.leaveType.size() <= 50 &&
             data.startDate is string && data.startDate.size() <= 30 &&
             data.endDate is string && data.endDate.size() <= 30 &&
             data.durationDays is number &&
             data.reason is string && data.reason.size() <= 500 &&
             data.status is string && ((data.status == 'Pending') || (data.status == 'Disetujui') || (data.status == 'Ditolak')) &&
             data.requestDate is string && data.requestDate.size() <= 30;
    }

    match /leaves/{leaveId} {
      allow read: if isVerified();
      allow create: if isVerified() && isValidId(leaveId) && isValidLeave(incoming()) &&
                    exists(/databases/$(database)/documents/staff/$(incoming().staffId));
      allow update: if isVerified() && isValidId(leaveId) && isValidLeave(incoming()) && (
        isAdmin() ||
        (existing().status == 'Pending' && incoming().diff(existing()).affectedKeys().hasOnly(['reason', 'startDate', 'endDate', 'durationDays', 'leaveType', 'status']))
      ) && incoming().staffId == existing().staffId; 
      // Terminal state guard
      allow delete: if isAdmin() && isValidId(leaveId);
    }

    // ----------------------------------------------------
    // Collection: documents
    // ----------------------------------------------------
    function isValidDocument(data) {
      return data.keys().hasAll(['name', 'category', 'uploadDate', 'fileSize', 'description', 'fileType']) &&
             data.name is string && data.name.size() <= 200 &&
             data.category is string && ((data.category == 'Laporan') || (data.category == 'Legal') || (data.category == 'Keuangan') || (data.category == 'HR/SOP') || (data.category == 'Memo/Umum')) &&
             data.uploadDate is string && data.uploadDate.size() <= 30 &&
             data.fileSize is string && data.fileSize.size() <= 20 &&
             data.description is string && data.description.size() <= 500 &&
             data.fileType is string && data.fileType.size() <= 50;
    }

    match /documents/{documentId} {
      allow read: if isVerified();
      allow create: if isVerified() && isValidId(documentId) && isValidDocument(incoming());
      allow update: if isVerified() && isValidId(documentId) && isValidDocument(incoming()) && (
        isAdmin() ||
        (incoming().diff(existing()).affectedKeys().hasOnly(['name', 'category', 'description', 'tags']))
      );
      allow delete: if isAdmin() && isValidId(documentId);
    }
  }
}
